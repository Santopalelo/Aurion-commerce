NODE_ENV=production
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aurion-commerce

# JWT (generate with: openssl rand -hex 64)
JWT_ACCESS_SECRET=your_64_char_random_secret_here
JWT_REFRESH_SECRET=your_other_64_char_random_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Webhook signing secret — the API refuses every webhook without it.
# Dashboard: Developers > Webhooks > Add endpoint
#   https://your-api.com/api/v1/webhooks/stripe
# Local: stripe listen --forward-to localhost:5000/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Frontend URLs (dev defaults)
CLIENT_URL=http://localhost:5173
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174

# Production URLs (set after Vercel deployment)
# These are also the CSRF allow-list for /auth/login, /auth/refresh-token
# and /auth/logout — the refresh cookie is SameSite=None, so only these
# exact origins may send it.
# One origin per value, or several separated by commas:
#   PRODUCTION_DASHBOARD_URL=https://a.vercel.app,https://b.vercel.app
PRODUCTION_DASHBOARD_URL=https://your-app.vercel.app
PRODUCTION_STOREFRONT_URL=https://your-storefront.vercel.app
PRODUCTION_ADMIN_URL=https://your-admin-panel.vercel.app

# Platform
PLATFORM_NAME=Aurion Commerce
PLATFORM_URL=https://aurioncommerce.com
ADMIN_EMAIL=admin@auriontech.com