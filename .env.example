# ================================
# AURION COMMERCE - ENVIRONMENT VARIABLES
# ================================
# Copy this file to .env and fill in real values
# NEVER commit .env to Git

# ===== SERVER =====
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174

# Deployed app origins. The API uses these for the CORS allow-list AND for
# the CSRF origin check on cookie-authenticated routes (/auth/login,
# /auth/refresh-token, /auth/logout).
# The refresh cookie is SameSite=None, so only these exact origins are
# allowed to send it — a Vercel preview deployment is NOT trusted.
# One origin per value, or several separated by commas. A value that is not
# a URL is ignored and reported at startup.
PRODUCTION_DASHBOARD_URL=https://aurion-commerce-merchant-dashboard.vercel.app
PRODUCTION_STOREFRONT_URL=https://aurion-commerce-storefront.vercel.app
PRODUCTION_ADMIN_URL=https://aurion-commerce-admin-panel.vercel.app

# ===== DATABASE =====
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aurion-commerce

# ===== REDIS (for cache and job queues) =====
REDIS_URL=redis://localhost:6379

# ===== JWT AUTHENTICATION =====
# Generate strong random strings (at least 64 chars each)
JWT_ACCESS_SECRET=replace_with_random_64_char_string_here
JWT_REFRESH_SECRET=replace_with_another_random_64_char_string_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ===== CLOUDINARY (image storage) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== STRIPE (payments) =====
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# The webhook secret proves that a payment event really came from Stripe.
# Get it from the Stripe Dashboard:  Developers > Webhooks > Add endpoint
#   endpoint URL: https://your-api.com/api/v1/webhooks/stripe
#   events:      payment_intent.succeeded, payment_intent.payment_failed,
#                payment_intent.processing, charge.refunded
# Then copy the "Signing secret" (whsec_...) into the line below.
#
# LOCAL DEVELOPMENT (no public URL needed):
#   stripe listen --forward-to localhost:5000/api/v1/webhooks/stripe
#   -> it prints a whsec_... secret; paste that here and restart the API.
#
# If this is empty the API refuses every webhook (503) on purpose —
# an unverified payment event must never be trusted.
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ===== RESEND (transactional emails) =====
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@aurioncommerce.com

# ===== ALGOLIA (product search) - Phase 2 =====
ALGOLIA_APP_ID=your_app_id
ALGOLIA_API_KEY=your_api_key
ALGOLIA_INDEX_NAME=aurion_products

# ===== PLATFORM SETTINGS =====
PLATFORM_NAME=Aurion Commerce
PLATFORM_URL=https://aurioncommerce.com
ADMIN_EMAIL=admin@auriontech.com